[TEMPLATE]
# Copy to .env and fill locally. Never commit the real key.
#
# The server reads this file once at startup (app/mvp/env.js). A key already
# present in the process environment wins, so a shell/service-manager value is
# never replaced. Only key names are logged, never values.
GEMINI_API_KEY=

# PostHog AI Observability (optional). Empty = every helper is a pass-through.
# Project API key from PostHog: Settings -> Project -> API key.
POSTHOG_API_KEY=
# Optional ingest host; defaults to https://us.i.posthog.com
# POSTHOG_HOST=https://eu.i.posthog.com

# OpenRouter (optional but needed for AI Research). Read by
# app/mvp/provider/openrouter.js; filled from this file by app/mvp/env.js when
# the process environment has no value. Never logged.
OPENROUTER_API_KEY=
# Optional model slug; the module has a placeholder default, but Gate 4
# requires the Owner to approve the exact model before any live request.
# OPENROUTER_MODEL=

# Live-request interlock. Unset means no request may leave the process, so a
# key present in the environment cannot spend anything by default. Only set to
# 1 after an Owner-approved Gate 4 live test authorization.
# ACE_LLM_LIVE_ENABLED=1

# Gemini (Google AI Studio) — second provider, selectable in Settings ⚙️.
# The AI Studio key is free-tier; see Google's data-use terms before binding.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OrcaRouter (OpenAI-compatible gateway) — third provider, selectable in Settings ⚙️.
# Models ending in `-free` bill $0.00 per request (e.g. z-ai/glm-5.3-flash-free).
# ORCAROUTER_API_KEY=
# ORCAROUTER_MODEL=z-ai/glm-5.3-flash-free
# ORCAROUTER_ENDPOINT=https://api.orcarouter.ai/v1/chat/completions

# Default AI provider for every step when Settings does not pick one.
# One of: openrouter | orcarouter | gemini
# ACE_LLM_PROVIDER=orcarouter

# Optional external data root
# ACE_IMPORT_ROOT=Y:\ACE Data\imports
