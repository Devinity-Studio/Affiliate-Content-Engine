[TEMPLATE]
# Copy to .env and fill locally. Never commit the real key.
#
# NOTE: this application has no .env loader. Nothing reads this file at
# runtime; copy the values into the process environment (your shell, task
# runner, or service config) for them to take effect.
GEMINI_API_KEY=

# PostHog AI Observability (optional). Empty = every helper is a pass-through.
# Project API key from PostHog: Settings -> Project -> API key.
POSTHOG_API_KEY=
# Optional ingest host; defaults to https://us.i.posthog.com
# POSTHOG_HOST=https://eu.i.posthog.com

# OpenRouter (optional). Read only from the process environment by
# app/mvp/provider/openrouter.js — never from a .env file, and never logged.
OPENROUTER_API_KEY=
# Optional model slug; the module has a placeholder default, but Gate 4
# requires the Owner to approve the exact model before any live request.
# OPENROUTER_MODEL=

# Live-request interlock. Unset means no request may leave the process, so a
# key present in the environment cannot spend anything by default. Only set to
# 1 after an Owner-approved Gate 4 live test authorization.
# ACE_LLM_LIVE_ENABLED=1

# Optional external data root
# ACE_IMPORT_ROOT=Y:\ACE Data\imports
